{
    "name": "lenny-dnd-data",
    "version": "1.0.0",
    "description": "Generate the data for the Lenny D&D bot. Automatically formats the descriptions for the Discord embeds.",
    "main": "index.js",
    "scripts": {
        "generate": "ts-node src/main.ts",
        "interfaces": "ts-interface-builder src/interfaces.ts && prettier package.json \"./src/interfaces-ti.ts\" --write",
        "prettier": "prettier package.json \"./src/**/*.ts\" --write",
        "lint": "npx eslint ./src --ext .ts,.tsx --ignore-pattern ./5etools-src",
        "dev": "npm run interfaces && npm run generate"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pipieter/lenny-dnd-data.git"
    },
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/pipieter/lenny-dnd-data/issues"
    },
    "homepage": "https://github.com/pipieter/lenny-dnd-data#readme",
    "dependencies": {
        "command-exists": "^1.2.9",
        "kleur": "^4.1.5",
        "lenny-dnd-data": "file:",
        "ts-interface-checker": "^1.0.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/command-exists": "^1.2.3",
        "ts-interface-builder": "^0.3.3",
        "@typescript-eslint/eslint-plugin": "^8.46.3",
        "@typescript-eslint/parser": "^8.46.3",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-unused-imports": "^4.3.0",
        "prettier": "^3.5.3",
        "typescript-eslint": "^8.46.3"
    }
}
